{
    "$schema": "gigischema.json",
    "version": "1.01",
    "variables": [
        {
            "name": "RenderSize",
            "type": "Uint2",
            "dflt": "1920, 1080",
            "visibility": "User"
        },
        {
            "name": "CurveType",
            "type": "Int",
            "visibility": "User",
            "Enum": "CurveTypes"
        },
        {
            "name": "CurveOrder",
            "type": "Int",
            "dflt": "Quintic",
            "visibility": "User",
            "Enum": "CurveOrders"
        },
        {
            "name": "CP1",
            "type": "Float3",
            "dflt": "0.0, 0.0, 0.0",
            "visibility": "User",
            "onUserChange": {
                "name": "MakeCurveTexture"
            },
            "UISettings": {
                "UIHint": "Color"
            }
        },
        {
            "name": "CP2",
            "type": "Float3",
            "dflt": "0.2, 0.2, 0.2",
            "visibility": "User",
            "onUserChange": {
                "name": "MakeCurveTexture"
            },
            "UISettings": {
                "UIHint": "Color"
            }
        },
        {
            "name": "CP3",
            "type": "Float3",
            "dflt": "0.4, 0.4, 0.4",
            "visibility": "User",
            "onUserChange": {
                "name": "MakeCurveTexture"
            },
            "UISettings": {
                "UIHint": "Color"
            }
        },
        {
            "name": "CP4",
            "type": "Float3",
            "dflt": "0.6, 0.6, 0.6",
            "visibility": "User",
            "onUserChange": {
                "name": "MakeCurveTexture"
            },
            "UISettings": {
                "UIHint": "Color"
            }
        },
        {
            "name": "CP5",
            "type": "Float3",
            "dflt": "0.8, 0.8, 0.8",
            "visibility": "User",
            "onUserChange": {
                "name": "MakeCurveTexture"
            },
            "UISettings": {
                "UIHint": "Color"
            }
        },
        {
            "name": "CP6",
            "type": "Float3",
            "dflt": "1.0, 1.0, 1.0",
            "visibility": "User",
            "onUserChange": {
                "name": "MakeCurveTexture"
            },
            "UISettings": {
                "UIHint": "Color"
            }
        },
        {
            "name": "RaysPerPixelPerFrame",
            "comment": "Rays per pixel per frame when rendering the scene",
            "type": "Int",
            "dflt": "16",
            "visibility": "User"
        },
        {
            "name": "NumCPsMinus1Float",
            "type": "Float"
        },
        {
            "name": "ColorGrade",
            "comment": "Should the color grading happen once per frame, or with every ray?",
            "type": "Int",
            "visibility": "User",
            "Enum": "ColorGradeTimings"
        },
        {
            "name": "NormalizedCPs",
            "comment": "When clicked, makes a linear no-op curve out of the control points",
            "type": "Bool",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Button"
            }
        },
        {
            "name": "ResetAccumulation",
            "type": "Bool",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Button"
            }
        },
        {
            "name": "MakeCurveTexture",
            "type": "Bool",
            "dflt": "true"
        },
        {
            "name": "iFrame",
            "type": "Int",
            "visibility": "Host"
        },
        {
            "name": "CameraChanged",
            "type": "Bool",
            "visibility": "Host"
        },
        {
            "name": "InvViewMtx",
            "type": "Float4x4",
            "visibility": "Host"
        },
        {
            "name": "InvViewProjMtx",
            "type": "Float4x4",
            "visibility": "Host"
        },
        {
            "name": "CameraPos",
            "type": "Float3",
            "visibility": "Host"
        }
