{
    "$schema": "gigischema.json",
    "version": "1.01",
    "variables": [
        {
            "name": "CurveOrder",
            "type": "Int",
            "dflt": "Quintic",
            "visibility": "User",
            "Enum": "CurveOrders"
        },
        {
            "name": "TextureFormat",
            "type": "Int",
            "visibility": "User",
            "Enum": "TextureFormats"
        },
        {
            "name": "CP1",
            "type": "Float",
            "dflt": "0",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Slider",
                "min": "0",
                "max": "1"
            }
        },
        {
            "name": "CP2",
            "type": "Float",
            "dflt": "1",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Slider",
                "min": "0",
                "max": "1"
            }
        },
        {
            "name": "CP3",
            "type": "Float",
            "dflt": "0",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Slider",
                "min": "0",
                "max": "1"
            }
        },
        {
            "name": "CP4",
            "type": "Float",
            "dflt": "1",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Slider",
                "min": "0",
                "max": "1"
            }
        },
        {
            "name": "CP5",
            "type": "Float",
            "dflt": "0",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Slider",
                "min": "0",
                "max": "1"
            }
        },
        {
            "name": "CP6",
            "type": "Float",
            "dflt": "1",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Slider",
                "min": "0",
                "max": "1"
            }
        },
        {
            "name": "ShowPolynomial",
            "type": "Bool",
            "dflt": "true",
            "visibility": "User"
        },
        {
            "name": "ShowDeCasteljauTexture",
            "type": "Bool",
            "dflt": "true",
            "visibility": "User"
        },
        {
            "name": "ShowSeilerTexture",
            "type": "Bool",
            "dflt": "true",
            "visibility": "User"
        },
        {
            "name": "ShowHybrid",
            "comment": "de CastelJau texture, but the last lerp done in shaders at full f32 precision. Quartic and Quintic are already hybrid.",
            "type": "Bool",
            "dflt": "false",
            "visibility": "User"
        },
        {
            "name": "ShowControlPoints",
            "comment": "In black",
            "type": "Bool",
            "dflt": "true",
            "visibility": "User"
        },
        {
            "name": "ComparisonMode",
            "comment": "Colors the output for a better comparison between two curve types",
            "type": "Bool",
            "dflt": "false",
            "visibility": "User"
        },
        {
            "name": "RenderSize",
            "type": "Uint2",
            "dflt": "512, 512",
            "visibility": "User"
        },
        {
            "name": "PolynomialColor",
            "type": "Float3",
            "dflt": "1, 0, 0",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Color"
            }
        },
        {
            "name": "DeCasteljauColor",
            "type": "Float3",
            "dflt": "0, 1, 0",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Color"
            }
        },
        {
            "name": "SeilerColor",
            "type": "Float3",
            "dflt": "0, 0, 1",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Color"
            }
        },
        {
            "name": "HybridColor",
            "type": "Float3",
            "dflt": "0, 0, 1",
            "visibility": "User",
            "UISettings": {
                "UIHint": "Color"
            }
        }
    ],
    "shaders": [
        {
            "name": "DrawCurves",
            "fileName": "ViewCurves_DrawCurves.hlsl",
            "resources": [
                {
                    "name": "Output",
                    "access": "UAV",
                    "type": "Texture"
                },
                {
                    "name": "DCTexture2D",
                    "access": "SRV",
                    "type": "Texture",
                    "texture": {
                        "viewType": "Float"
                    }
                },
                {
                    "name": "DCTexture3D",
                    "access": "SRV",
                    "type": "Texture",
                    "texture": {
                        "dimension": "Texture3D",
                        "viewType": "Float"
                    }
                },
                {
                    "name": "SeilerTexture2D",
                    "access": "SRV",
                    "type": "Texture",
                    "texture": {
                        "viewType": "Float"
                    }
                },
                {
                    "name": "SeilerTexture3D",
                    "access": "SRV",
                    "type": "Texture",
                    "texture": {
                        "dimension": "Texture3D",
                        "viewType": "Float"
                    }
                },
                {
                    "name": "DCTexture2DU8",
                    "access": "SRV",
                    "type": "Texture",
                    "texture": {
                        "viewType": "Float"
                    }
                },
                {
                    "name": "DCTexture3DU8",
                    "access": "SRV",
                    "type": "Texture",
                    "texture": {
                        "dimension": "Texture3D",
                        "viewType": "Float"
                    }
                },
                {
                    "name": "SeilerTexture2DU8",
                    "access": "SRV",
                    "type": "Texture",
                    "texture": {
                        "viewType": "Float"
                    }
                },
                {
                    "name": "SeilerTexture3DU8",
                    "access": "SRV",
                    "type": "Texture",
                    "texture": {
                        "dimension": "Texture3D",
                        "viewType": "Float"
                    }
                }
            ],
            "samplers": [
                {
                    "name": "LinearSampler"
                }
            ]
        },
        {
            "name": "MakeCurveTextures",
            "fileName": "ViewCurves_MakeCurveTextures.hlsl",
            "NumThreads": [
                1,
                1,
                1
            ],
            "resources": [
                {
                    "name": "DCTexture2D",
                    "access": "UAV",
                    "type": "Texture",
                    "texture": {
                        "viewType": "Float"
                    }
                },
                {
                    "name": "DCTexture3D",
                    "access": "UAV",
                    "type": "Texture",
                    "texture": {
                        "dimension": "Texture3D",
                        "viewType": "Float"
                    }
                },
                {
                    "name": "SeilerTexture2D",
                    "access": "UAV",
                    "type": "Texture",
                    "texture": {
                        "viewType": "Float"
                    }
                },
                {
                    "name": "SeilerTexture3D",
                    "access": "UAV",
                    "type": "Texture",
                    "texture": {
                        "dimension": "Texture3D",
                        "viewType": "Float"
                    }
                }
            ]
        }
    ],
    "fileCopies": [
        {
            "fileName": "sRGB.hlsli",
